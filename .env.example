# Public site URL (used for canonical URLs, sitemap, structured data)
NEXT_PUBLIC_SITE_URL=https://kllezo.com

# Contact details shown on the site
NEXT_PUBLIC_CONTACT_EMAIL=hello@kllezo.com
# WhatsApp number, international format, digits only (e.g. 919876543210). Leave empty to hide WhatsApp CTAs.
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Google Analytics 4 measurement ID (shared by both experiences)
NEXT_PUBLIC_GA_ID=

# Supabase — enquiry storage (server only). Run supabase/migrations/*.sql first.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Resend — team notification email for new enquiries
RESEND_API_KEY=
KLLEZO_NOTIFY_EMAIL=team@kllezo.com
KLLEZO_FROM_EMAIL="Kllezo Website <website@kllezo.com>"
